---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import RecipeMeta from '../../components/RecipeMeta.astro';
import IngredientList from '../../components/IngredientList.astro';
import MethodSteps from '../../components/MethodSteps.astro';
import ScaleControl from '../../components/ScaleControl.astro';
import CookMode from '../../components/CookMode.astro';
import LangToggle from '../../components/LangToggle.astro';
import { localeOf, recipeKeyOf } from '../../lib/recipes';
import { validateSteps } from '../../lib/references';
import { localeHref } from '../../lib/url';
import { t, format } from '../../i18n/ui';
import { LOCALES, type Locale } from '../../i18n/config';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { locale: localeOf(recipe.id), slug: recipeKeyOf(recipe.id) },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { data } = recipe;
const locale = localeOf(recipe.id) as Locale;
const key = recipeKeyOf(recipe.id);
const s = t(locale);
const { Content } = await render(recipe);

// Warn (at build time) about ingredient references that don't resolve.
const unmatched = validateSteps(data.method, data.ingredients);
if (unmatched.length > 0) {
  console.warn(
    `[recipes] ${recipe.id}: unmatched ingredient references: ${unmatched.join(', ')}`,
  );
}

const nutritionEntries = data.nutrition ? Object.entries(data.nutrition) : [];

const alternates = LOCALES.map((l) => ({
  locale: l,
  url: new URL(localeHref(l, key), Astro.site).href,
}));

// Payload for the client controller (scaling + popovers).
const clientData = {
  baseServings: data.servings,
  ingredients: Object.fromEntries(
    data.ingredients.map((i) => [i.name.toLowerCase(), i]),
  ),
  t: {
    servings: s.servings,
    select: s.select,
    stepOf: s.stepOf,
    next: s.next,
    done: s.done,
  },
};
---

<Base title={data.title} locale={locale} description={data.title} alternates={alternates}>
  <div class="hero-scene">
  <div class="hero-photo" id="hero-photo">
    {
      data.image ? (
        <Image src={data.image} alt={data.title} widths={[480, 960]} sizes="100vw" />
      ) : (
        <div class="hero-fallback"><span aria-hidden="true">🍽️</span></div>
      )
    }
    <div class="scrim" aria-hidden="true"></div>
  </div>

  <a class="round back" href={localeHref(locale)} aria-label={s.backToRecipes}>
    <Icon name="lucide:chevron-left" size={24} />
  </a>
  <div class="hero-actions">
    <LangToggle locale={locale} path={key} variant="overlay" />
    <button class="round share" type="button" data-share aria-label={s.shareRecipe}>
      <Icon name="lucide:share" size={20} />
    </button>
  </div>

  <div class="topbar" id="hero-topbar">
    <span class="topbar-title">{data.title}</span>
  </div>

  <article id="hero-scroll">
    <div id="hero-content">
    <div class="hero-spacer" id="hero-spacer">
      <h1 class="hero-title">{data.title}</h1>
    </div>

    <div class="sheet" id="hero-sheet">
    <div class="actions">
      <button class="start" type="button" data-cook-start>
        <Icon name="lucide:play" size={20} />
        {s.start}
      </button>
    </div>
    <div class="container">
      <RecipeMeta
        servings={data.servings}
        prepTime={data.prepTime}
        cookTime={data.cookTime}
        locale={locale}
      />

      <section>
        <div class="section-head">
          <h2>{s.ingredients}</h2>
          <button class="scale-btn accent" type="button" data-scale-toggle>{s.scale}</button>
        </div>
        <ScaleControl ingredients={data.ingredients} servings={data.servings} locale={locale} />
        <IngredientList ingredients={data.ingredients} />
      </section>

      <section>
        <h2>{s.method}</h2>
        <MethodSteps method={data.method} />
      </section>

      {
        nutritionEntries.length > 0 && (
          <section>
            <h2>{s.nutrition}</h2>
            <p class="muted note">{format(s.nutritionNote, { n: data.servings })}</p>
            <ul class="nutrition">
              {nutritionEntries.map(([k, v]) => (
                <li>
                  <span class="muted">{k}</span>
                  <span>{v}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="notes">
        <Content />
      </section>

      {data.sourceUrl && (
        <a class="source" href={data.sourceUrl} target="_blank" rel="noopener">
          {s.viewOriginalSource}
        </a>
      )}
    </div>
    </div>
    </div>

    <CookMode locale={locale} />
  </article>
  </div>

  <script
    is:inline
    type="application/json"
    id="recipe-data"
    data-copied={s.linkCopied}
    set:html={JSON.stringify(clientData)}
  />
</Base>

<script>
  import '../../scripts/recipe-page.ts';
  import '../../scripts/hero-parallax.ts';

  document.querySelector('[data-share]')?.addEventListener('click', async () => {
    const shareData = { title: document.title, url: location.href };
    try {
      if (navigator.share) await navigator.share(shareData);
      else {
        await navigator.clipboard.writeText(location.href);
        const msg = document
          .getElementById('recipe-data')
          ?.getAttribute('data-copied');
        alert(msg || 'Link copied');
      }
    } catch {
      /* user cancelled — ignore */
    }
  });
</script>

<style>
  .container {
    max-width: 760px;
  }

  /* Non-scrolling viewport-sized scene: the document/body never scrolls,
     so iOS Safari never rubber-bands the root — only #hero-scroll does,
     which is a plain overflow container where touchmove preventDefault()
     reliably works, unlike on the document body. */
  .hero-scene {
    position: relative;
    height: 100dvh;
    overflow: hidden;
  }

  /* Cover photo, absolutely positioned within the non-scrolling scene so
     the transparent spacer below lets it show through while the sheet
     scrolls over it. */
  .hero-photo {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100vw;
    height: min(calc(100vw / 1.2), 440px);
    overflow: hidden;
    transform-origin: top;
    will-change: transform;
  }
  .hero-photo :global(img),
  .hero-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The actual scrollable pane — everything scrolls here, not on the
     document, so the photo (a sibling, not an ancestor) stays untouched
     by iOS's native rubber-band and is only moved by hero-parallax.ts. */
  #hero-scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  /* Dragged down in lockstep with the photo's scale during pull-down, so
     the sheet stays glued to the photo's growing bottom edge (no gap). */
  #hero-content {
    will-change: transform;
  }
  .hero-fallback {
    display: grid;
    place-items: center;
    font-size: 4rem;
    background: linear-gradient(135deg, #232526, #414345);
  }
  .scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 160px;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.55));
  }

  /* Reserves the cover's visible height in the flow; the title overlays
     its bottom-leading corner and scrolls with the sheet, not the photo. */
  .hero-spacer {
    position: relative;
    z-index: 1;
    height: calc(min(100vw / 1.2, 440px) - 28px);
  }
  .hero-title {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 12px;
    margin: 0;
    color: #fff;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Content sheet: slides over the fixed photo as the page scrolls;
     corner radius flattens and the top bar fades in via hero-parallax.ts. */
  .sheet {
    position: relative;
    z-index: 2;
    background: var(--bg);
    border-radius: 28px 28px 0 0;
  }

  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    height: calc(env(safe-area-inset-top, 0px) + 56px);
    padding-top: env(safe-area-inset-top, 0px);
    background: var(--bg);
    opacity: 0;
  }
  .topbar-title {
    font-size: 1rem;
    font-weight: 700;
    opacity: 0;
  }

  .round {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 16px);
    z-index: 3;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(6px);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    line-height: 1;
  }
  .back {
    left: 16px;
  }
  .hero-actions {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 16px);
    right: 16px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .share {
    position: static;
    font-size: 1rem;
  }
  .actions {
    max-width: 760px;
    margin: 0 auto;
    padding: 16px 20px 8px;
  }
  .start {
    display: flex;
    width: 100%;
    justify-content: center;
    align-items: center;
    gap: 8px;
    border: 0;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    background: var(--start);
    color: #062b12;
    font-size: 1.15rem;
    font-weight: 800;
    box-shadow: 0 8px 24px rgba(52, 199, 89, 0.35);
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 32px 0 12px;
  }
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .scale-btn {
    border: 0;
    background: var(--surface);
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 1rem;
  }
  .note {
    margin: 0 0 10px;
    font-size: 0.9rem;
  }
  .nutrition {
    list-style: none;
    margin: 0;
    padding: 8px 4px;
    background: var(--surface);
    border-radius: var(--radius);
  }
  .nutrition li {
    display: flex;
    justify-content: space-between;
    padding: 10px 14px;
  }
  .notes :global(p) {
    color: var(--muted);
  }
  .source {
    display: inline-block;
    margin-top: 24px;
    color: var(--accent);
    font-weight: 600;
  }
</style>
